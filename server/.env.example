# Copy to .env and edit. (For a VPS on the internet, use deploy/vps/.env.example instead.)
SSAS_ORG_NAME=My organisation
# Minutes of inactivity before an admin is signed out, and the longest a sign-in lasts.
SSAS_SESSION_IDLE_MIN=30
SSAS_SESSION_MAX_HOURS=12
# Optional: only these addresses may open the admin pages (comma-separated), e.g. 192.168.1.0/24
# The screens' API is not affected.
# SSAS_ADMIN_ALLOW=192.168.1.0/24
