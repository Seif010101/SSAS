# Copy to .env (cp .env.example .env) and edit with: nano .env

# The address of your server. Make a DNS "A" record for it that points to this VPS first.
SSAS_DOMAIN=attendance.example.com

# Shown on the pages and in the authenticator app.
SSAS_ORG_NAME=My organisation

# Minutes of inactivity before an admin is signed out, and the longest a sign-in lasts.
SSAS_SESSION_IDLE_MIN=30
SSAS_SESSION_MAX_HOURS=12

# Suggested on the internet: only these addresses may open the admin pages (comma-separated).
# Find your office address at https://ifconfig.me . The screens are not affected.
# SSAS_ADMIN_ALLOW=203.0.113.7/32
